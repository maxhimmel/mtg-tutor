{
  "name": "@mtg-tutor/backend",
  "version": "0.1.0",
  "description": "Convex backend: set ingestion, draft sessions, coaching stream",
  "private": true,
  "type": "module",
  "main": "./convex/_generated/api.js",
  "types": "./convex/_generated/api.d.ts",
  "exports": {
    ".": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "backtest-scoring": "node scripts/backtest-scoring.mjs",
    "bench-backfill-draft": "node scripts/bench-backfill-draft.mjs",
    "bench-bots": "node scripts/bench-bots.mjs",
    "bench-io": "node scripts/bench-io.mjs",
    "bench-llm": "node scripts/bench-llm.mjs",
    "bench-report": "node scripts/bench-report.mjs",
    "build": "node scripts/codegen.mjs",
    "build-set-stats": "node scripts/build-set-stats.mjs",
    "challenge-fixture": "node scripts/challenge-fixture.mjs",
    "check-access": "node scripts/check-access.mjs",
    "check-availability": "node scripts/check-set-availability.mjs",
    "deploy": "convex deploy",
    "dev": "node scripts/dev.mjs",
    "dev:only": "convex dev",
    "env:pull": "convex env list > .env.convex && echo 'wrote .env.convex (gitignored)'",
    "env:push": "convex env set --force --from-file .env.convex",
    "env:watch": "node scripts/watch-env.mjs",
    "feedback": "node scripts/feedback.mjs",
    "fit-bot-policy": "node scripts/fit-bot-policy.mjs",
    "ingest-sets": "node scripts/ingest-sets.mjs",
    "llm": "node scripts/llm-provider.mjs",
    "new-set": "node scripts/new-set.mjs",
    "seed-set-stats": "node scripts/seed-set-stats.mjs",
    "smoke-draft": "node scripts/smoke-draft.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "validate-pack-model": "node scripts/validate-pack-model.mjs",
    "validate-set-stats": "node scripts/validate-set-stats.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/openai-compatible": "^3",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@mtg-tutor/core": "workspace:*",
    "@posthog/convex": "2.1.0",
    "ai": "^7",
    "convex": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.7.0",
    "convex-test": "^0.0.54",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

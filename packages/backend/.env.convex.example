# Deployment environment variables -- the ones Convex functions read via
# process.env. These do NOT live in .env.local: functions run on Convex's
# infrastructure, so they can only ever see variables set on the deployment.
#
# Workflow:
#   pnpm --filter @mtg-tutor/backend env:pull   # deployment -> .env.convex
#   $EDITOR packages/backend/.env.convex        # edit values
#   pnpm --filter @mtg-tutor/backend env:push   # .env.convex -> deployment
#
# `pnpm dev:web` also starts a watcher that pushes this file on save, so an edit
# applies without the push step. It only pushes on a real content change, and
# only ever to dev. It does NOT sync at startup -- if you edited while dev was
# stopped, run env:push once. For CLI-only work (`pnpm dev`), the watcher is not
# running: use `pnpm --filter @mtg-tutor/backend env:watch` in another terminal.
#
# env:push targets your dev deployment. For production, run
# `npx convex env set --prod --force --from-file .env.convex` deliberately --
# there is no script for it, so prod is never a typo away.
#
# .env.convex is gitignored because env:pull writes real secret values into it.
# Copy this file to get started.

# --- Model provider -----------------------------------------------------------
# anthropic (default, used by prod) | openai-compatible | claude-cli
#
# claude-cli answers from the Claude Code CLI on your own machine and spends no
# API credit: run `pnpm claude-bridge` in another terminal and switch with
# `pnpm llm claude-cli`. Dev only -- the seam refuses a non-loopback URL. The
# two variables below are optional; these are their defaults.
# CLAUDE_BRIDGE_URL=http://127.0.0.1:8787/v1
# CLAUDE_BRIDGE_MODEL=sonnet
LLM_PROVIDER=openai-compatible

# Only read when LLM_PROVIDER=openai-compatible.
# Groq: https://api.groq.com/openai/v1   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
# Enumerate real ids with: curl $LLM_BASE_URL/models -H "Authorization: Bearer $KEY"
# On Groq only the gpt-oss models accept json_schema, which review.ts needs.
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_replace_me
# Set to false only for an endpoint stuck on legacy json_object mode.
# LLM_JSON_SCHEMA=true

# --- Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Auth (managed by convex.json authKit config; usually leave alone) --------
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_ENVIRONMENT_ID=

# --- Analytics ----------------------------------------------------------------
# REQUIRED on every deployment, because the PostHog component declares it that
# way and Convex refuses a push that wires an optional parent var to a required
# component one. Empty is legal and means off -- which is what a dev deployment
# wants, so local drafting does not put fake picks into the real project.
#
# Set it on prod BEFORE deploying, not after: vercel.json runs `convex deploy` as
# the first step of the web build, so an unset prod variable fails the build
# rather than just losing analytics.
#   npx convex env set POSTHOG_PROJECT_TOKEN phc_... --prod
#
# The browser needs the same token as NEXT_PUBLIC_POSTHOG_KEY in Vercel, or the
# two halves of a person's timeline land in different projects.
POSTHOG_PROJECT_TOKEN=
# Defaults to https://us.i.posthog.com. Set only for EU Cloud or self-hosted.
# POSTHOG_HOST=

# --- Telling a challenger their friend finished (optional, all-or-nothing) ----
# Both of these plus RESEND_API_KEY and WORKOS_API_KEY, or nothing is sent and
# the action logs which are missing. The in-app badge works either way, so this
# is a nicety rather than a prerequisite.
#
# RESEND_FROM needs a VERIFIED DOMAIN in Resend, which is why it has no default.
# The access-request mail sends from Resend's shared onboarding@resend.dev,
# which only ever delivers to the Resend account owner's own address -- fine for
# "somebody wants in", useless for mailing a friend.
# RESEND_FROM=MTG Tutor <noreply@yourdomain.com>
#
# Where the web app is, so the mail can link to the comparison. The same value
# as the web app's NEXT_PUBLIC_WORKOS_REDIRECT_URI minus /callback -- a copy,
# because that variable lives in Next's environment and this action runs in
# Convex, which cannot read it. One per deployment, and they pair 1:1: the dev
# deployment is only ever driven from localhost, prod only from the live site.
# APP_URL=http://localhost:3000
